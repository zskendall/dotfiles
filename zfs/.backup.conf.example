SRC=/path/to/source
DEST=user@host:/path/to/dest

# for each service in DUMP_SERVICES, add the following variables:
#   <SERVICE>_CONTAINER - container name running postgres
#   <SERVICE>_USER      - postgres user
#   <SERVICE>_DB        - database name
#   <SERVICE>_DUMP_PATH - where to store the dump
DUMP_SERVICES="service1 service2"

EXCLUDE=path/to/file/relative/to/source

NTFY_URL=
NTFY_TOKEN=
