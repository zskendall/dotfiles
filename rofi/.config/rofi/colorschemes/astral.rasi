/* Astral Colors to be used by ROFI themes */

@import "general.rasi"

* {
  primary:                 #5e3a92;
  secondary:               #070916;
  text-color:              #498db9;
  background:              @grey50;
  background-alt:          #00082499;
  selected-background:     #070916cc;
  border-color:            @text-color;
  accent-subtle:           #5e3a9233;
  accent-border:           #5e3a92bf;
  secondary-subtle:        #07091666;
}

