/* ROFI theme for options menu
 * Based on theme by ntcarlson:
 * https://github.com/ntcarlson/dotfiles/blob/tau/config/rofi/options_menu.rasi
 */

@theme "config.rasi"

configuration {
    font: "Material Icons 40";
}

window {
  width:                          520;
  children:                       [ listview ];
  background-color:               transparent;
}

listview {
  columns:                        5;
  lines:                          1;
  spacing:                        16;
}

element {
  background-color:               @secondary-subtle;
  border-radius:                  30;
  padding:                        12 10;
}

element selected {
  background-color:               @accent-subtle;
  border-radius:                  30;
  border:                         1.5px;
  border-color:                   @accent-border;
  color:                          @primary;
}

