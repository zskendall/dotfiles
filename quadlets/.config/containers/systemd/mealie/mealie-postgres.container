[Container]
Pod=mealie.pod

AutoUpdate=registry
ContainerName=postgres_mealie
Image=docker.io/library/postgres:15

EnvironmentFile=%h/mealie/.env

Volume=%h/mealie/postgres:/var/lib/postgresql/data

HealthCmd=pg_isready
HealthInterval=30s
HealthTimeout=20s
HealthRetries=5
Notify=healthy

[Service]
Restart=always
